# TravelSync Client Environment Variables
# Copy this file to .env and fill in your actual values
# DO NOT commit actual keys to version control

# Backend API Base URL
# Development: http://localhost:3000/api
# Production: https://your-render-backend.onrender.com/api
VITE_API_BASE_URL=http://localhost:3000/api
VITE_API_URL=http://localhost:3000/api

# Google Maps API Key
# Get from: https://console.cloud.google.com/apis/credentials
# Enable: Maps JavaScript API, Places API, Geocoding API
VITE_GOOGLE_MAPS_KEY=your_google_maps_api_key_here

# ── Firebase Web SDK ──────────────────────────────────────────────────────────
# Get from: Firebase Console → Project Settings → Your apps → Web app
# These are SAFE to expose in the browser (they identify your Firebase project only)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
