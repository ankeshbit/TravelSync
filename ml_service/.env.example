# TravelSync Python ML Recommendation Service Environment Variables
# Copy to .env in ml_service directory if custom overrides are needed

# Path to the destination catalog CSV (relative to repo root or absolute path)
TRAVELSYNC_CSV_PATH=ML/travelsync_destin.original.csv

# Allowed origins for CORS (comma-separated, typically backend Express server and frontend Vite app)
ML_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Fail startup if dataset fails to load (default: false, returns 503 from /health instead)
FAIL_FAST_STARTUP=false

# Port for uvicorn server (default: 8000)
PORT=8000
