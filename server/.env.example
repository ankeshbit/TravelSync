# TravelSync Server Environment Variables
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

# ── Core Required Configuration ───────────────────────────────────────────────

# Neon PostgreSQL Database Connection URL (Required)
# Get from: https://console.neon.tech → your project → Connection details
DATABASE_URL=postgresql://user:password@ep-cool-project-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Direct URL for Prisma migrations (bypasses Neon connection pooler)
DIRECT_URL=postgresql://user:password@ep-cool-project-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# JWT Secret for WebSocket authentication & session signing (Required: min 32 characters)
JWT_SECRET=replace-with-random-jwt-secret-min-32-chars-long-string

# Refresh Secret for session token rotation (Required: min 32 characters, must differ from JWT_SECRET)
REFRESH_SECRET=replace-with-random-refresh-secret-min-32-chars-long-different

# Allowed Origins for CORS (Required: comma-separated list of allowed domains, no trailing slash)
# In production, ONLY these origins are allowed. In development, localhost is also permitted.
ALLOWED_ORIGIN=http://localhost:5173,http://localhost:3000

# Server Port (Default: 3000)
PORT=3000

# Node Environment (development | production | test)
NODE_ENV=development

# ── Firebase Admin SDK (Required for User Authentication) ─────────────────────
# Get from: Firebase Console → Project Settings → Service Accounts
#           → Generate new private key → download JSON
# Copy the three fields below from the downloaded JSON (never commit the file itself)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Paste the private_key value here; on platforms like Render use literal \n (not newlines)
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_here\n-----END PRIVATE KEY-----\n"

# ── AI & External Services (Optional) ─────────────────────────────────────────

# Groq API Key for AI Trip Planner
# Get from: https://console.groq.com
GROQ_API_KEY=gsk_your-groq-api-key-here

# Email credentials for OTP (account deletion verification)
SMTP_EMAIL=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password-here

# Unsplash API Key (for trip cover image auto-generation)
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here
