# TravelSync Server Environment Variables
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

# Neon PostgreSQL Database Connection URL
# Get from: https://console.neon.tech → your project → Connection details
# Format: postgresql://[user]:[password]@[neon-hostname]/[dbname]?sslmode=require
DATABASE_URL=postgresql://user:password@ep-cool-project-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# JWT Secret — must be a random string, minimum 32 characters
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-random-32-char-string

# JWT Refresh Secret — must be different from JWT_SECRET
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REFRESH_SECRET=replace-with-another-random-32-char-string

# Frontend URL for CORS (no trailing slash)
ALLOWED_ORIGIN=http://localhost:5173

# Server Port
PORT=3000

# Node Environment (development | production)
NODE_ENV=development

# Groq API Key for AI Trip Planner
# Get from: https://console.groq.com
GROQ_API_KEY=gsk_your-groq-api-key-here

# Email credentials for OTP
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password-here

# Unsplash API Key (for trip cover image auto-generation)
# Get yours free at: https://unsplash.com/developers → Create an app → copy "Access Key"
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here
